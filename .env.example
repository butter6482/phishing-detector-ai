# LLM (OpenRouter)
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=openai/gpt-4o-mini
USE_OPENROUTER=true

# Google Safe Browsing
GOOGLE_SAFE_BROWSING_KEY=REPLACE_ME

# CORS: orígenes permitidos separados por coma (el frontend desplegado va aquí)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limit del endpoint /analyze
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend (produccion; en dev se usa el proxy de Vite)
VITE_API_URL=http://127.0.0.1:8000
